# IBVAP Foundation Environment Configuration Template
# Do NOT store real credentials, production secrets, or private RTSP URLs in this file.

# System Settings
IBVAP_ENV=development
IBVAP_DEBUG=true
IBVAP_HOST=127.0.0.1
IBVAP_PORT=8000

# Database Settings
DATABASE_URL=sqlite:///./data/ibvap.db

# Logging
LOG_LEVEL=INFO

# Storage
EVIDENCE_STORAGE_PATH=./data/evidence
DEMO_STORAGE_PATH=./data/demo

# Security & Secrets (Placeholders only)
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
RTSP_DEFAULT_USERNAME=camera_user_placeholder
RTSP_DEFAULT_PASSWORD=camera_password_placeholder
